<UserControl x:Class="ToolpathViewer.App.Controls.OpenGLViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Focusable="True"
             ClipToBounds="True">
    <Grid x:Name="RootGrid"
          Background="#121214"
          Focusable="True"
          PreviewMouseDown="OnViewportMouseDown"
          PreviewMouseMove="OnViewportMouseMove"
          PreviewMouseUp="OnViewportMouseUp"
          PreviewMouseWheel="OnViewportMouseWheel">

        <!-- OpenTK Hardware-Accelerated OpenGL Direct3D Surface -->
        <gl:GLWpfControl x:Name="GlSurface"
                         Render="GlSurface_OnRender"
                         Focusable="True" />

        <!-- Floating HUD Overlay with Navigation Hints (IsHitTestVisible=False to never block mouse) -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16"
                Background="#9018181C"
                CornerRadius="8"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Padding="12,8"
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="3D CAMERA CONTROLS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#80FFFFFF"
                           Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Orbit: " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                    <TextBlock Text="Left Click + Drag" Foreground="#99A0B0" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Pan: " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                    <TextBlock Text="Right / Middle Click + Drag" Foreground="#99A0B0" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Zoom: " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                    <TextBlock Text="Mouse Scroll Wheel" Foreground="#99A0B0" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Loading indicator overlay -->
        <Grid x:Name="LoadingOverlay"
              Background="#80000000"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,12" />
                <TextBlock Text="Loading Toolpath..." Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

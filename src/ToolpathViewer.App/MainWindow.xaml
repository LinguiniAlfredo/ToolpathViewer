<ui:FluentWindow x:Class="ToolpathViewer.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:controls="clr-namespace:ToolpathViewer.App.Controls"
                  xmlns:vm="clr-namespace:ToolpathViewer.App.ViewModels"
                  mc:Ignorable="d"
                  Title="{Binding WindowTitle}"
                  Height="780" Width="1200"
                  MinHeight="550" MinWidth="850"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FitViewCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Windows 11 TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Cube24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 2. Windows 11 Modern CommandBar / Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel LastChildFill="False">
                <!-- Primary Action: Open File Button -->
                <ui:Button Appearance="Primary"
                           Command="{Binding OpenFileCommand}"
                           ToolTip="Open toolpath file (*.h, *.txt) [Ctrl+O]"
                           Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                        <TextBlock Text="Open Toolpath" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Appearance="Secondary"
                           Command="{Binding ReloadCommand}"
                           ToolTip="Reload current file [Ctrl+R]"
                           Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                        <TextBlock Text="Reload" />
                    </StackPanel>
                </ui:Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2,8,2" />

                <!-- Camera View Presets -->
                <TextBlock Text="Views:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />

                <ui:Button Appearance="Transparent"
                           Command="{Binding FitViewCommand}"
                           ToolTip="Fit toolpath to screen [Ctrl+F]"
                           Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CenterHorizontal24" Margin="0,0,4,0" />
                        <TextBlock Text="Fit" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Appearance="Transparent"
                           Command="{Binding SetPresetCommand}"
                           CommandParameter="Isometric"
                           ToolTip="Isometric 3D View"
                           Margin="0,0,4,0"
                           Content="3D Iso" />

                <ui:Button Appearance="Transparent"
                           Command="{Binding SetPresetCommand}"
                           CommandParameter="Top"
                           ToolTip="Top View (XY Plane)"
                           Margin="0,0,4,0"
                           Content="Top" />

                <ui:Button Appearance="Transparent"
                           Command="{Binding SetPresetCommand}"
                           CommandParameter="Front"
                           ToolTip="Front View (XZ Plane)"
                           Margin="0,0,4,0"
                           Content="Front" />

                <ui:Button Appearance="Transparent"
                           Command="{Binding SetPresetCommand}"
                           CommandParameter="Right"
                           ToolTip="Side View (YZ Plane)"
                           Margin="0,0,12,0"
                           Content="Side" />

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2,8,2" />

                <!-- Display Toggles -->
                <TextBlock Text="Layers:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />

                <ToggleButton IsChecked="{Binding ShowCuts}"
                              ToolTip="Toggle Cutting Moves (M03)"
                              Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#00D2FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cuts (M03)" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ShowRapids}"
                              ToolTip="Toggle Rapid Positioning Moves (M05)"
                              Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#FFAA00" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Rapids (M05)" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ShowGrid}"
                              ToolTip="Toggle 3D Reference Grid"
                              Margin="0,0,4,0"
                              Content="Grid" />

                <ToggleButton IsChecked="{Binding ShowAxes}"
                              ToolTip="Toggle XYZ Coordinate Axes"
                              Margin="0,0,4,0"
                              Content="Axes" />

                <ToggleButton IsChecked="{Binding ShowBoundingBox}"
                              ToolTip="Toggle 3D Bounding Box Wireframe"
                              Margin="0,0,12,0"
                              Content="Bounds" />

                <!-- Sample Files Quick-Load (Right side) -->
                <DockPanel DockPanel.Dock="Right">
                    <ui:Button Appearance="Transparent"
                               Command="{Binding ToggleThemeCommand}"
                               ToolTip="Toggle Dark/Light theme"
                               Margin="8,0,0,0">
                        <ui:SymbolIcon Symbol="WeatherMoon24" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Command="{Binding LoadSampleCommand}"
                               CommandParameter="Box4mm.h"
                               ToolTip="Load example Box4mm.h"
                               Margin="4,0,0,0"
                               Content="Box 4mm" />

                    <ui:Button Appearance="Transparent"
                               Command="{Binding LoadSampleCommand}"
                               CommandParameter="1mmCross.h"
                               ToolTip="Load example 1mmCross.h"
                               Margin="4,0,0,0"
                               Content="1mm Cross" />

                    <TextBlock Text="Examples:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- 3. Central Working Area: OpenGL 3D Viewport + Right Inspector Card -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- OpenGL Viewport -->
            <controls:OpenGLViewport x:Name="Viewport" Grid.Column="0" />

            <!-- Vertical Grid Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}" />

            <!-- Inspector Panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" Orientation="Vertical">

                        <!-- Panel Header -->
                        <TextBlock Text="Toolpath Details"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,16" />

                        <!-- File Info Card -->
                        <ui:Card Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="FILE INFO"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,2">
                                    <TextBlock Text="Name:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Size:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding FileSizeText}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Format:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Laser Toolpath (.h)" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Geometry Metrics Card -->
                        <ui:Card Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="TRAJECTORY METRICS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,2">
                                    <TextBlock Text="Total Segments:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalSegments}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#00D2FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Cut Moves (M03):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CutSegmentsCount}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Cut Length:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="14,0,0,0" />
                                    <TextBlock Text="{Binding TotalCutLengthText}" Foreground="#00D2FF" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#FFAA00" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Rapid Moves (M05):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RapidSegmentsCount}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Rapid Length:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="14,0,0,0" />
                                    <TextBlock Text="{Binding TotalRapidLengthText}" Foreground="#FFAA00" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Separator Margin="0,6" />

                                <Grid Margin="0,2">
                                    <TextBlock Text="Total Travel:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalLengthText}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Bounding Box Card -->
                        <ui:Card Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="BOUNDING BOX &amp; EXTENTS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,2">
                                    <TextBlock Text="Dimensions (W×H×D):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding DimensionsText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="X Range:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BoundsXText}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Y Range:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BoundsYText}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Z Range:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BoundsZText}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Visual Legend Card -->
                        <ui:Card Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="3D VIEW LEGEND"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Border Width="12" Height="3" Background="#00D2FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cutting Line (M03 - Laser ON)" FontSize="11" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Border Width="12" Height="2" Background="#FFAA00" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Rapid Move (M05 - Laser OFF)" FontSize="11" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#1FE633" Margin="2,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Start Position (First Point)" FontSize="11" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#FF4040" Margin="2,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="End Position (Last Point)" FontSize="11" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border Width="4" Height="4" Background="#FF4040" Margin="1" />
                                        <Border Width="4" Height="4" Background="#33E659" Margin="1" />
                                        <Border Width="4" Height="4" Background="#4099FF" Margin="1" />
                                    </StackPanel>
                                    <TextBlock Text="Axes: Red=X, Green=Y, Blue=Z" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Windows 11 Fluent StatusBar -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="OpenGL 3.3 Core • Hardware Accelerated"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</ui:FluentWindow>

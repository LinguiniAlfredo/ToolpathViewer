<UserControl x:Class="AblationStudio.App.Controls.OpenGLViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Focusable="True"
             ClipToBounds="True">
    <Grid x:Name="RootGrid"
          Background="#121214"
          Focusable="True"
          PreviewMouseDown="OnViewportMouseDown"
          PreviewMouseMove="OnViewportMouseMove"
          PreviewMouseUp="OnViewportMouseUp"
          PreviewMouseWheel="OnViewportMouseWheel"
          MouseLeave="OnViewportMouseLeave">

        <!-- OpenTK Hardware-Accelerated OpenGL Direct3D Surface -->
        <gl:GLWpfControl x:Name="GlSurface"
                         Render="GlSurface_OnRender"
                         Focusable="True" />

        <!-- Floating HUD Overlay with Navigation Hints and 3D View Legend (IsHitTestVisible=False to never block mouse) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="16"
                    IsHitTestVisible="False">
            <!-- 3D Camera Controls -->
            <Border Background="#9018181C"
                    CornerRadius="8"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    Padding="12,8"
                    Margin="0,0,10,0"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="3D CAMERA CONTROLS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#80FFFFFF"
                               Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Orbit: " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                        <TextBlock Text="Left Click + Drag" Foreground="#99A0B0" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Pan: " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                        <TextBlock Text="Right / Middle Click + Drag" Foreground="#99A0B0" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Zoom: " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                        <TextBlock Text="Mouse Scroll Wheel" Foreground="#99A0B0" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3D View Legend -->
            <Border Background="#9018181C"
                    CornerRadius="8"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    Padding="12,8"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="3D VIEW LEGEND"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#80FFFFFF"
                               Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Border Width="12" Height="3" CornerRadius="1.5" Background="#00D2FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Profile " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                        <TextBlock Text="(M03 - Laser ON)" Foreground="#99A0B0" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Border Width="12" Height="3" CornerRadius="1.5" Background="#D946EF" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Hatch " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                        <TextBlock Text="(M03 - Laser ON)" Foreground="#99A0B0" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Border Width="12" Height="2" CornerRadius="1" Background="#FFAA00" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Jump " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                        <TextBlock Text="(M05 - Laser OFF)" Foreground="#99A0B0" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#1FE633" Margin="2,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Start Position " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                        <TextBlock Text="(First Point)" Foreground="#99A0B0" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#FF4040" Margin="2,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="End Position " FontWeight="SemiBold" Foreground="#CCD0D8" FontSize="11" />
                        <TextBlock Text="(Last Point)" Foreground="#99A0B0" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Loading indicator overlay -->
        <Grid x:Name="LoadingOverlay"
              Background="#80000000"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,12" />
                <TextBlock Text="Loading Toolpath..." Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

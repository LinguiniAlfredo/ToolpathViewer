<ui:FluentWindow x:Class="AblationStudio.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:controls="clr-namespace:AblationStudio.App.Controls"
                  xmlns:vm="clr-namespace:AblationStudio.App.ViewModels"
                  xmlns:core="clr-namespace:AblationStudio.Core.Models;assembly=AblationStudio.Core"
                  xmlns:shapes="clr-namespace:AblationStudio.Core.Shapes;assembly=AblationStudio.Core"
                  mc:Ignorable="d"
                  Title="{Binding WindowTitle}"
                  Height="780" Width="1200"
                  MinHeight="550" MinWidth="850"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  AllowDrop="True"
                  Drop="OnWindowDrop"
                  DragOver="OnWindowDragOver">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewFileCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportMachineFileCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportMachineFileCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FitViewCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateSelectedShapeCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Windows 11 TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Cube24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 2. Application Menu Bar (File, Edit, View, Tools) -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,2">
            <Menu Background="Transparent" IsMainMenu="False">
                <!-- File Operations Menu -->
                <MenuItem Header="_File" Padding="8,4">
                    <MenuItem Header="_New Project"
                              InputGestureText="Ctrl+N"
                              Command="{Binding NewFileCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentAdd24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Open Project..."
                              InputGestureText="Ctrl+O"
                              Command="{Binding OpenProjectCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Save Project"
                              InputGestureText="Ctrl+S"
                              Command="{Binding SaveProjectCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save Project _As..."
                              InputGestureText="Ctrl+Shift+S"
                              Command="{Binding SaveProjectAsCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="SaveCopy24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="_Open Machine File for Simulation (.h, .txt)..."
                              Command="{Binding OpenMachineFileCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="PlayCircle24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Import Contour Shape (.cls)..."
                              InputGestureText="Ctrl+I"
                              Command="{Binding ImportMachineFileCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowImport24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Export Machine File (.h)..."
                              InputGestureText="Ctrl+E"
                              Command="{Binding ExportMachineFileCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowExportUp24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Example Files">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Folder24" />
                        </MenuItem.Icon>
                        <MenuItem Header="Q Logo (Q_Logo.cls)"
                                  Command="{Binding LoadSampleCommand}"
                                  CommandParameter="Q_Logo.cls" />
                        <MenuItem Header="US Flag (Flag.cls)"
                                  Command="{Binding LoadSampleCommand}"
                                  CommandParameter="Flag.cls" />
                        <MenuItem Header="Box 4mm (Box4mm.h)"
                                  Command="{Binding LoadSampleCommand}"
                                  CommandParameter="Box4mm.h" />
                        <MenuItem Header="1mm Cross (1mmCross.h)"
                                  Command="{Binding LoadSampleCommand}"
                                  CommandParameter="1mmCross.h" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="E_xit"
                              InputGestureText="Alt+F4"
                              Command="{Binding ExitCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowExit20" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <!-- Edit Menu -->
                <MenuItem Header="_Edit" Padding="8,4">
                    <MenuItem Header="_Undo"
                              InputGestureText="Ctrl+Z"
                              Command="{Binding UndoCommand}"
                              ToolTip="{Binding UndoButtonTooltip}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Redo"
                              InputGestureText="Ctrl+Y"
                              Command="{Binding RedoCommand}"
                              ToolTip="{Binding RedoButtonTooltip}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowRedo24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="_Duplicate Selected Shape"
                              InputGestureText="Ctrl+D"
                              Command="{Binding DuplicateSelectedShapeCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Delete Selected Shape"
                              InputGestureText="Del"
                              Command="{Binding DeleteSelectedShapeCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Clear All Shapes"
                              Command="{Binding ClearAllShapesCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Deselect"
                              InputGestureText="Esc"
                              Command="{Binding DeselectShapeCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <!-- View Menu -->
                <MenuItem Header="_View" Padding="8,4">
                    <MenuItem Header="_Fit to Screen"
                              InputGestureText="Ctrl+F"
                              Command="{Binding FitViewCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="CenterHorizontal24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="3D _Isometric View"
                              Command="{Binding SetPresetCommand}"
                              CommandParameter="Isometric" />
                    <MenuItem Header="_Top View (XY)"
                              Command="{Binding SetPresetCommand}"
                              CommandParameter="Top" />
                    <MenuItem Header="_Front View (XZ)"
                              Command="{Binding SetPresetCommand}"
                              CommandParameter="Front" />
                    <MenuItem Header="_Right Side View (YZ)"
                              Command="{Binding SetPresetCommand}"
                              CommandParameter="Right" />
                    <Separator />
                    <MenuItem Header="Show _Grid"
                              IsCheckable="True"
                              IsChecked="{Binding ShowGrid}" />
                    <MenuItem Header="Show _Axes Gizmo"
                              IsCheckable="True"
                              IsChecked="{Binding ShowAxes}" />
                    <MenuItem Header="Show _Bounding Box"
                              IsCheckable="True"
                              IsChecked="{Binding ShowBoundingBox}" />
                    <MenuItem Header="Show _Cut Moves (M03)"
                              IsCheckable="True"
                              IsChecked="{Binding ShowCuts}" />
                    <MenuItem Header="Show _Hatch Moves (M03)"
                              IsCheckable="True"
                              IsChecked="{Binding ShowHatch}" />
                    <MenuItem Header="Show _Jump Moves (M05)"
                              IsCheckable="True"
                              IsChecked="{Binding ShowRapids}" />
                    <MenuItem Header="Live Path _Trace (Progressive)"
                              IsCheckable="True"
                              IsChecked="{Binding IsProgressiveSimulation}" />
                    <Separator />
                    <MenuItem Header="Toggle _Dark / Light Theme"
                              Command="{Binding ToggleThemeCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="WeatherMoon24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <!-- Tools Menu -->
                <MenuItem Header="_Tools" Padding="8,4">
                    <MenuItem Header="_Select / Orbit Tool"
                              InputGestureText="V"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="{x:Static vm:ShapeToolType.Select}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Cursor24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Line Tool"
                              InputGestureText="L"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="{x:Static vm:ShapeToolType.Line}">
                        <MenuItem.Icon>
                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Rectangle Tool"
                              InputGestureText="R"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="{x:Static vm:ShapeToolType.Rectangle}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Square24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Circle Tool"
                              InputGestureText="C"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="{x:Static vm:ShapeToolType.Circle}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Circle24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Polygon Tool"
                              InputGestureText="P"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="{x:Static vm:ShapeToolType.Polygon}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Pentagon20" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="_Play / Pause Simulation"
                              Command="{Binding TogglePlaySimulationCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Play24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Stop Simulation"
                              Command="{Binding StopSimulationCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Stop24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Live Path _Trace"
                              IsCheckable="True"
                              IsChecked="{Binding IsProgressiveSimulation}" />
                </MenuItem>

            </Menu>
        </Border>

        <!-- 3. Windows 11 Modern CommandBar / Toolbar -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel LastChildFill="False">
                <!-- New File Button -->
                <ui:Button Appearance="Secondary"
                           Command="{Binding NewFileCommand}"
                           ToolTip="New Project Canvas [Ctrl+N]"
                           Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentAdd24" Margin="0,0,6,0" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </ui:Button>

                <!-- Primary Action: Open Project / File Button -->
                <ui:Button Appearance="Primary"
                           Command="{Binding OpenProjectCommand}"
                           ToolTip="Open Project or Machine File (*.abs, *.h) [Ctrl+O]"
                           Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                        <TextBlock Text="Open" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>

                <!-- Save Project Button -->
                <ui:Button Appearance="Secondary"
                           Command="{Binding SaveProjectCommand}"
                           ToolTip="Save Project (*.abs) [Ctrl+S]"
                           Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </ui:Button>

                <!-- Export Machine File Button -->
                <ui:Button Appearance="Secondary"
                           Command="{Binding ExportMachineFileCommand}"
                           ToolTip="Export Machine File (*.h) [Ctrl+E]"
                           Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowExportUp24" Margin="0,0,6,0" />
                        <TextBlock Text="Export (.h)" />
                    </StackPanel>
                </ui:Button>

                <!-- Import Machine File Button -->
                <ui:Button Appearance="Secondary"
                           Command="{Binding ImportMachineFileCommand}"
                           ToolTip="Import Contour Shape (*.cls) into Current Project [Ctrl+I]"
                           Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowImport24" Margin="0,0,6,0" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </ui:Button>

                <!-- Undo Button -->
                <ui:Button Appearance="Secondary"
                           Command="{Binding UndoCommand}"
                           ToolTip="{Binding UndoButtonTooltip}"
                           Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowUndo24" Margin="0,0,6,0" />
                        <TextBlock Text="Undo" />
                    </StackPanel>
                </ui:Button>

                <!-- Redo Button -->
                <ui:Button Appearance="Secondary"
                           Command="{Binding RedoCommand}"
                           ToolTip="{Binding RedoButtonTooltip}"
                           Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowRedo24" Margin="0,0,6,0" />
                        <TextBlock Text="Redo" />
                    </StackPanel>
                </ui:Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2,8,2" />

                <!-- Camera View Presets -->
                <TextBlock Text="Views:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />

                <ui:Button Appearance="Transparent"
                           Command="{Binding FitViewCommand}"
                           ToolTip="Fit toolpath to screen [Ctrl+F]"
                           Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CenterHorizontal24" Margin="0,0,4,0" />
                        <TextBlock Text="Fit" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Appearance="Transparent"
                           Command="{Binding SetPresetCommand}"
                           CommandParameter="Isometric"
                           ToolTip="Isometric 3D View"
                           Margin="0,0,4,0"
                           Content="3D Iso" />

                <ui:Button Appearance="Transparent"
                           Command="{Binding SetPresetCommand}"
                           CommandParameter="Top"
                           ToolTip="Top View (XY Plane)"
                           Margin="0,0,4,0"
                           Content="Top" />

                <ui:Button Appearance="Transparent"
                           Command="{Binding SetPresetCommand}"
                           CommandParameter="Front"
                           ToolTip="Front View (XZ Plane)"
                           Margin="0,0,4,0"
                           Content="Front" />

                <ui:Button Appearance="Transparent"
                           Command="{Binding SetPresetCommand}"
                           CommandParameter="Right"
                           ToolTip="Side View (YZ Plane)"
                           Margin="0,0,12,0"
                           Content="Side" />

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2,8,2" />

                <!-- Display Toggles -->
                <TextBlock Text="Layers:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />

                <ToggleButton IsChecked="{Binding ShowCuts}"
                              ToolTip="Toggle Profile Moves"
                              Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#00D2FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Profile"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(TextElement.Foreground)}" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ShowHatch}"
                              ToolTip="Toggle Hatch Infill Moves"
                              Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#D946EF" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Hatch"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(TextElement.Foreground)}" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ShowRapids}"
                              ToolTip="Toggle Jump Positioning Moves"
                              Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#FFAA00" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Jumps"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(TextElement.Foreground)}" />
                    </StackPanel>
                </ToggleButton>


                <ToggleButton IsChecked="{Binding ShowGrid}"
                              ToolTip="Toggle 3D Reference Grid"
                              Margin="0,0,4,0"
                              Content="Grid" />

                <ToggleButton IsChecked="{Binding ShowAxes}"
                              ToolTip="Toggle XYZ Orientation Gizmo"
                              Margin="0,0,4,0"
                              Content="Axes" />

                <ToggleButton IsChecked="{Binding ShowBoundingBox}"
                              ToolTip="Toggle 3D Bounding Box Wireframe"
                              Margin="0,0,12,0"
                              Content="Bounds" />

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2,8,2" />

                <!-- Toolpath Simulation Controls -->
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasSimulation}">
                    <TextBlock Text="Simulate:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />

                    <ui:Button Appearance="Primary"
                               Command="{Binding TogglePlaySimulationCommand}"
                               ToolTip="Simulate toolpath [Play / Pause]"
                               Margin="0,0,4,0"
                               Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,4,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Play24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimulationPlaying}" Value="True">
                                                <Setter Property="Symbol" Value="Pause24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Play" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimulationPlaying}" Value="True">
                                                <Setter Property="Text" Value="Pause" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding StopSimulationCommand}"
                               ToolTip="Stop and reset simulation"
                               Margin="0,0,8,0"
                               Padding="6,4">
                        <ui:SymbolIcon Symbol="Stop24" />
                    </ui:Button>

                    <TextBlock Text="Feed:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <Slider Minimum="5"
                            Maximum="4000"
                            Value="{Binding SimulationFeedrate, Mode=TwoWay}"
                            Width="85"
                            VerticalAlignment="Center"
                            ToolTip="{Binding SimulationFeedrateText}"
                            Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SimulationFeedrate, StringFormat='{}{0:F0} mm/s'}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11"
                               Margin="0,0,12,0" />
                </StackPanel>

                <!-- Theme Toggle (Right side) -->
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Transparent"
                           Command="{Binding ToggleThemeCommand}"
                           ToolTip="Toggle Dark/Light theme"
                           Margin="8,0,0,0">
                    <ui:SymbolIcon Symbol="WeatherMoon24" />
                </ui:Button>
            </DockPanel>
        </Border>

        <!-- 4. Central Working Area: Left Toolbar + OpenGL 3D Viewport + Right Inspector Card -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Vertical Tool Menu -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="6,8">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="TOOLS"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,4,0,8" />

                    <!-- Select Tool -->
                    <ui:Button Command="{Binding SelectToolCommand}"
                               CommandParameter="{x:Static vm:ShapeToolType.Select}"
                               ToolTip="Select / Orbit Tool (Click placed shape to edit) [V]"
                               Width="38" Height="38" Margin="0,2" Padding="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTool}" Value="{x:Static vm:ShapeToolType.Select}">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Cursor24" />
                    </ui:Button>

                    <!-- Line Tool -->
                    <ui:Button Command="{Binding SelectToolCommand}"
                               CommandParameter="{x:Static vm:ShapeToolType.Line}"
                               ToolTip="Line Tool (Click &amp; drag on grid) [L]"
                               Width="38" Height="38" Margin="0,2" Padding="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTool}" Value="{x:Static vm:ShapeToolType.Line}">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1"
                                       Fill="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ui:Button>

                    <!-- Rectangle Tool -->
                    <ui:Button Command="{Binding SelectToolCommand}"
                               CommandParameter="{x:Static vm:ShapeToolType.Rectangle}"
                               ToolTip="Rectangle Tool (Click &amp; drag on grid) [R]"
                               Width="38" Height="38" Margin="0,2" Padding="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTool}" Value="{x:Static vm:ShapeToolType.Rectangle}">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Square24" />
                    </ui:Button>

                    <!-- Circle Tool -->
                    <ui:Button Command="{Binding SelectToolCommand}"
                               CommandParameter="{x:Static vm:ShapeToolType.Circle}"
                               ToolTip="Circle Tool (Click center &amp; drag radius) [C]"
                               Width="38" Height="38" Margin="0,2" Padding="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTool}" Value="{x:Static vm:ShapeToolType.Circle}">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Circle24" />
                    </ui:Button>

                    <!-- Polygon Tool -->
                    <ui:Button Command="{Binding SelectToolCommand}"
                               CommandParameter="{x:Static vm:ShapeToolType.Polygon}"
                               ToolTip="Regular Polygon Tool (Click &amp; drag on grid) [P]"
                               Width="38" Height="38" Margin="0,2" Padding="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTool}" Value="{x:Static vm:ShapeToolType.Polygon}">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Pentagon20" />
                    </ui:Button>

                    <!-- Text Tool -->
                    <ui:Button Command="{Binding SelectToolCommand}"
                               CommandParameter="{x:Static vm:ShapeToolType.Text}"
                               ToolTip="Text Tool (Click or drag on grid to place text) [T]"
                               Width="38" Height="38" Margin="0,2" Padding="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTool}" Value="{x:Static vm:ShapeToolType.Text}">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="TextFont24" />
                    </ui:Button>

                </StackPanel>
            </Border>

            <!-- Column 1: OpenGL Viewport -->
            <controls:OpenGLViewport x:Name="Viewport" Grid.Column="1" />

            <!-- Column 2: Vertical Grid Splitter -->
            <GridSplitter Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}" />

            <!-- Column 3: Inspector Panel (Context-Sensitive: Toolpath Details vs Shape Properties) -->
            <Border Grid.Column="3"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <!-- Toolpath Details ScrollViewer (Hidden when HasSelectedShape == True) -->
                    <ScrollViewer x:Name="ToolpathDetailsScroll" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnySelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="16" Orientation="Vertical">

                            <!-- Panel Header -->
                            <TextBlock Text="Toolpath Details"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,16" />

                            <!-- File Info Card -->
                            <ui:Card Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="FILE INFO"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Name:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Size:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding FileSizeText}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Format:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Laser Toolpath (.h)" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Toolpath Simulation Card -->
                            <ui:Card Margin="0,0,0,12" Padding="12" IsEnabled="{Binding HasSimulation}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="SIMULATION"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#18FFFFFF" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSimulationActive}" Value="True" />
                                                                <Condition Binding="{Binding SimulationSegmentType}" Value="{x:Static core:SegmentType.Cut}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="#2500E5FF" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSimulationActive}" Value="True" />
                                                                <Condition Binding="{Binding SimulationSegmentType}" Value="{x:Static core:SegmentType.Hatch}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="#25D946EF" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSimulationActive}" Value="True" />
                                                                <Condition Binding="{Binding SimulationSegmentType}" Value="{x:Static core:SegmentType.Rapid}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="#25FFAA00" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SimulationStateText}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DockPanel>

                                    <!-- Playback buttons -->
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Grid.Column="0"
                                                   Appearance="Primary"
                                                   Command="{Binding TogglePlaySimulationCommand}"
                                                   HorizontalAlignment="Stretch"
                                                   Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,6,0">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Play24" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSimulationPlaying}" Value="True">
                                                                    <Setter Property="Symbol" Value="Pause24" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Play Simulation" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSimulationPlaying}" Value="True">
                                                                    <Setter Property="Text" Value="Pause" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button Grid.Column="2"
                                                   Appearance="Secondary"
                                                   Command="{Binding StopSimulationCommand}"
                                                   ToolTip="Reset simulation to start"
                                                   Padding="10,6">
                                            <ui:SymbolIcon Symbol="Stop24" />
                                        </ui:Button>
                                    </Grid>

                                    <!-- Feedrate Control -->
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Feedrate:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SimulationFeedrateText}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12" />
                                    </Grid>
                                    <Slider Minimum="5"
                                            Maximum="4000"
                                            Value="{Binding SimulationFeedrate, Mode=TwoWay}"
                                            Margin="0,2,0,8" />

                                    <!-- Progress & Scrubbing -->
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Progress:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SimulationProgressText}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11" />
                                    </Grid>
                                    <Slider Minimum="0"
                                            Maximum="1"
                                            Value="{Binding SimulationProgress, Mode=TwoWay}"
                                            Margin="0,2,0,8" />

                                    <!-- Progressive Trace Mode -->
                                    <CheckBox IsChecked="{Binding IsProgressiveSimulation, Mode=TwoWay}"
                                              Content="Live Path Trace"
                                              FontSize="11"
                                              Margin="0,2,0,2"
                                              ToolTip="Draw the toolpath progressively as simulated rather than showing the full path context" />
                                    <CheckBox IsChecked="{Binding ShowGhostTrail, Mode=TwoWay}"
                                              Content="Show Ghost"
                                              FontSize="11"
                                              Margin="0,2,0,8"
                                              IsEnabled="{Binding IsProgressiveSimulation}"
                                              ToolTip="Display untraveled toolpath moves with faint transparency" />


                                    <!-- Live Coordinates Telemetry -->
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Tool Position:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SimulationPositionText}"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Geometry Metrics Card -->
                            <ui:Card Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="TRAJECTORY METRICS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Total Segments:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalSegments}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#00D2FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Profile Moves (M03):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding CutSegmentsCount}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#D946EF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Hatch Moves (M03):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding HatchSegmentsCount}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FFAA00" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Jump Moves (M05):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RapidSegmentsCount}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Separator Margin="0,8" />

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Total Profile Length:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalCutLengthText}" FontWeight="SemiBold" Foreground="#00D2FF" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Total Hatch Length:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalHatchLengthText}" FontWeight="SemiBold" Foreground="#D946EF" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Total Jump Length:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalRapidLengthText}" FontWeight="SemiBold" Foreground="#FFAA00" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Total Distance:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalLengthText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Bounding Box Metrics Card -->
                            <ui:Card Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="BOUNDING BOX"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Dimensions:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding DimensionsText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="X Range:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding BoundsXText}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Y Range:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding BoundsYText}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Z Range:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding BoundsZText}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>


                        </StackPanel>
                    </ScrollViewer>

                    <!-- Shape Properties ScrollViewer (Visible when HasSelectedShape == True) -->
                    <ScrollViewer x:Name="ShapePropertiesScroll" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedShape}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel Margin="16" Orientation="Vertical">
                            <!-- Header with Shape Name and Back/Deselect button -->
                            <DockPanel Margin="0,0,0,16">
                                <ui:Button DockPanel.Dock="Right"
                                           Appearance="Transparent"
                                           Command="{Binding DeselectShapeCommand}"
                                           ToolTip="Deselect shape and return to toolpath details"
                                           Padding="6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,4,0" />
                                        <TextBlock Text="Close" FontSize="11" />
                                    </StackPanel>
                                </ui:Button>
                                <StackPanel>
                                    <TextBlock Text="Shape Properties"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShape.ShapeType, StringFormat='Type: {0}'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>

                            <!-- General Settings Card -->
                            <ui:Card Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="GENERAL"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <TextBlock Text="Name:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,2" />
                                    <ui:TextBox Text="{Binding SelectedShape.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Layer ID:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                            <ui:TextBox Text="{Binding SelectedShape.LayerId, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Move Type:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                            <ComboBox SelectedValue="{Binding SelectedShape.CutType}"
                                                      SelectedValuePath="Tag"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Cut (M03)" Tag="{x:Static core:SegmentType.Cut}" />
                                                <ComboBoxItem Content="Jump (M05)" Tag="{x:Static core:SegmentType.Rapid}" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Position / Transform Card -->
                            <ui:Card Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="POSITION (MM)"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="X (Center)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                            <ui:TextBox Text="{Binding SelectedShape.PositionX, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Y (Center)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                            <ui:TextBox Text="{Binding SelectedShape.PositionY, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Z Height" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                            <ui:TextBox Text="{Binding SelectedShape.PositionZ, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Shape Dimensions Card -->
                            <ui:Card Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="DIMENSIONS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <!-- Circle Parameters -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedShape.ShapeType}" Value="Circle">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Radius (mm):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.Radius, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Diameter (mm):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.Diameter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Arc Discretization (Segments):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                        <ui:TextBox Text="{Binding SelectedShape.SegmentsCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Rectangle Parameters -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedShape.ShapeType}" Value="Rectangle">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Width (mm):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.Width, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Height (mm):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.Height, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Rotation Angle (°):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                        <ui:TextBox Text="{Binding SelectedShape.RotationDegrees, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Polygon Parameters -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedShape.ShapeType}" Value="Polygon">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Radius (mm):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.Radius, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Vertices / Sides:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.Sides, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Rotation Angle (°):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                        <ui:TextBox Text="{Binding SelectedShape.RotationDegrees, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Line Parameters -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedShape.ShapeType}" Value="Line">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="End X" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.EndX, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="End Y" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.EndY, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="End Z" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.EndZ, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <TextBlock Text="Length:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedShape.Length, StringFormat='{}{0:F2} mm'}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Angle:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedShape.AngleDegrees, StringFormat='{}{0:F1}°'}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Path Parameters -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedShape.ShapeType}" Value="Path">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Contours:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding SelectedShape.ContoursCount}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Total Points:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding SelectedShape.TotalPointsCount}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <TextBlock Text="Total Perimeter:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedShape.TotalPerimeterLength, StringFormat='{}{0:F2} mm'}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Text Parameters -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedShape.ShapeType}" Value="Text">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="Text Content:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,2" />
                                        <ui:TextBox Text="{Binding SelectedShape.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                        <TextBlock Text="Font Family:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,2" />
                                        <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                                                  SelectedItem="{Binding SelectedShape.FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,8" />

                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Height (mm):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.FontSize, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Spacing (mm):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                                <ui:TextBox Text="{Binding SelectedShape.LetterSpacing, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding SelectedShape.IsBold, Mode=TwoWay}"
                                                      Content="Bold"
                                                      FontSize="11" />
                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding SelectedShape.IsItalic, Mode=TwoWay}"
                                                      Content="Italic"
                                                      FontSize="11" />
                                        </Grid>

                                        <TextBlock Text="Rotation Angle (°):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,2" />
                                        <ui:TextBox Text="{Binding SelectedShape.RotationDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                        <Grid Margin="0,2">
                                            <TextBlock Text="Glyph Contours:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedShape.ContoursCount}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Total Perimeter:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedShape.TotalPerimeterLength, StringFormat='{}{0:F2} mm'}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>

                            <!-- Hatch Fill Card (Visible for closed shapes: Circle, Rectangle, Polygon) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedShape.IsClosed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <ui:Card Padding="12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="HATCH FILL"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <CheckBox IsChecked="{Binding SelectedShape.Hatch.IsEnabled, Mode=TwoWay}"
                                                      Content="Enable Fill"
                                                      HorizontalAlignment="Right"
                                                      FontSize="11" />
                                        </DockPanel>

                                        <!-- Fill Parameters (Enabled only when Hatch.IsEnabled is True) -->
                                        <StackPanel IsEnabled="{Binding SelectedShape.Hatch.IsEnabled}">
                                            <!-- Pattern Selector -->
                                            <TextBlock Text="Pattern Style:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,2" />
                                            <ComboBox SelectedValue="{Binding SelectedShape.Hatch.Pattern, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="0,0,0,8">
                                                <ComboBoxItem Content="ZigZag" Tag="{x:Static shapes:HatchPatternType.ZigZag}" />
                                                <ComboBoxItem Content="Spiral" Tag="{x:Static shapes:HatchPatternType.Spiral}" />
                                                <ComboBoxItem Content="Follow Profile" Tag="{x:Static shapes:HatchPatternType.FollowProfile}" />
                                            </ComboBox>

                                            <!-- Stepover (Line Spacing / Inset Distance) -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Stepover (mm):"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ui:TextBox Grid.Column="1"
                                                            Text="{Binding SelectedShape.Hatch.Stepover, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.###}'}"
                                                            KeyDown="OnNumericTextBoxKeyDown"
                                                            ToolTip="Directly enter stepover in millimeters (min 0.01 mm). Press Enter to apply."
                                                            Width="70"
                                                            Height="24"
                                                            Padding="6,1"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            TextAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            ClearButtonEnabled="False" />
                                            </Grid>
                                            <Slider Minimum="0.01"
                                                    Maximum="5.0"
                                                    TickFrequency="0.01"
                                                    SmallChange="0.01"
                                                    IsSnapToTickEnabled="False"
                                                    Value="{Binding SelectedShape.Hatch.Stepover, Mode=TwoWay}"
                                                    Margin="0,4,0,8" />

                                            <!-- Angle (Degrees) - Visible only for ZigZag (Hidden for Spiral and Follow Profile) -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedShape.Hatch.Pattern}" Value="{x:Static shapes:HatchPatternType.ZigZag}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Angle / Rotation (°):"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1"
                                                                Text="{Binding SelectedShape.Hatch.AngleDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.#}'}"
                                                                KeyDown="OnNumericTextBoxKeyDown"
                                                                ToolTip="Directly enter angle in degrees (0-360°). Press Enter to apply."
                                                                Width="70"
                                                                Height="24"
                                                                Padding="6,1"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                TextAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                ClearButtonEnabled="False" />
                                                </Grid>
                                                <Slider Minimum="0"
                                                        Maximum="360"
                                                        Value="{Binding SelectedShape.Hatch.AngleDegrees, Mode=TwoWay}"
                                                        Margin="0,4,0,8" />
                                            </StackPanel>

                                            <!-- Spiral Specific Settings -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedShape.Hatch.Pattern}" Value="{x:Static shapes:HatchPatternType.Spiral}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <CheckBox IsChecked="{Binding SelectedShape.Hatch.SpiralInward, Mode=TwoWay}"
                                                          Content="Reverse Direction (Spiral Inward)"
                                                          ToolTip="Spirals inward toward the center instead of outward from the center"
                                                          FontSize="11"
                                                          Margin="0,2,0,4" />
                                            </StackPanel>

                                            <!-- Follow Profile Specific Settings -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedShape.Hatch.Pattern}" Value="{x:Static shapes:HatchPatternType.FollowProfile}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <CheckBox IsChecked="{Binding SelectedShape.Hatch.FollowProfileOutward, Mode=TwoWay}"
                                                          Content="Reverse Direction (Fill Outward)"
                                                          ToolTip="Fills outward from the center toward the perimeter instead of inward from the perimeter"
                                                          FontSize="11"
                                                          Margin="0,2,0,4" />
                                            </StackPanel>

                                            <!-- Line Skip (Thermal Dispersion) Settings - For ZigZag and Follow Profile -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedShape.Hatch.Pattern}" Value="{x:Static shapes:HatchPatternType.Spiral}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <!-- Line Skip (Thermal Dispersion) -->
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Line Skip (Cooling):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding SelectedShape.Hatch.LineSkip, StringFormat='{}{0}'}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedShape.Hatch.AutoLineSkip}" Value="True">
                                                                        <Setter Property="Text" Value="Auto" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Slider Minimum="1"
                                                        Maximum="20"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding SelectedShape.Hatch.LineSkip, Mode=TwoWay}"
                                                        Margin="0,2,0,4">
                                                    <Slider.Style>
                                                        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                                            <Setter Property="IsEnabled" Value="True" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedShape.Hatch.AutoLineSkip}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter Property="Opacity" Value="0.4" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Slider.Style>
                                                </Slider>

                                                <CheckBox IsChecked="{Binding SelectedShape.Hatch.AutoLineSkip, Mode=TwoWay}"
                                                          Content="Auto Maximize Line Distance"
                                                          FontSize="11"
                                                          Margin="0,0,0,6" />
                                            </StackPanel>

                                            <!-- ZigZag Specific Settings -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedShape.Hatch.Pattern}" Value="{x:Static shapes:HatchPatternType.ZigZag}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <CheckBox IsChecked="{Binding SelectedShape.Hatch.CrossHatch, Mode=TwoWay}"
                                                          Content="Cross-Hatch (90° Dual Pass)"
                                                          FontSize="11"
                                                          Margin="0,2,0,4" />
                                            </StackPanel>

                                            <CheckBox IsChecked="{Binding SelectedShape.Hatch.KeepBoundary, Mode=TwoWay}"
                                                      Content="Keep Profile Boundary Outline"
                                                      FontSize="11"
                                                      Margin="0,2,0,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>
                            </Grid>

                            <!-- Actions: Duplicate, Delete -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0"
                                           Appearance="Secondary"
                                           Command="{Binding DuplicateSelectedShapeCommand}"
                                           HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Copy24" Margin="0,0,4,0" />
                                        <TextBlock Text="Duplicate" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Grid.Column="2"
                                           Appearance="Danger"
                                           Command="{Binding DeleteSelectedShapeCommand}"
                                           HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" Margin="0,0,4,0" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Multi-Shape Properties ScrollViewer (Visible when HasMultiSelection == True) -->
                    <ScrollViewer x:Name="MultiShapePropertiesScroll" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMultiSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel Margin="16" Orientation="Vertical">
                            <!-- Header with Count and Deselect button -->
                            <DockPanel Margin="0,0,0,16">
                                <ui:Button DockPanel.Dock="Right"
                                           Appearance="Transparent"
                                           Command="{Binding DeselectShapeCommand}"
                                           ToolTip="Deselect all shapes and return to toolpath details"
                                           Padding="6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,4,0" />
                                        <TextBlock Text="Deselect" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Multiple Shapes"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShapeCount, StringFormat='{}{0} shapes selected'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Actions Card -->
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Group Actions"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0"
                                                   Appearance="Secondary"
                                                   HorizontalAlignment="Stretch"
                                                   Command="{Binding DuplicateSelectedShapeCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Duplicate" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Grid.Column="2"
                                                   Appearance="Danger"
                                                   HorizontalAlignment="Stretch"
                                                   Command="{Binding DeleteSelectedShapeCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Delete" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>

                                    <TextBlock Text="Tip: Drag any selected shape to move all. Drag corner handles to scale the group. Drag the green top handle to rotate the group around its center."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Selected Shapes List -->
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Selected Items"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,0,0,8" />

                                    <ItemsControl ItemsSource="{Binding SelectedShapes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" Margin="0,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ShapeType}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Windows 11 Fluent StatusBar -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="OpenGL 3.3 Core • Hardware Accelerated"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</ui:FluentWindow>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Application Metadata -->
    <AssemblyName>AblationStudio</AssemblyName>
    <AssemblyTitle>Ablation Studio</AssemblyTitle>
    <Product>Ablation Studio</Product>
    <Description>Standalone Laser Ablation Studio &amp; 3D Toolpath Viewer</Description>
    <Version>1.0.0</Version>

    <!-- Standalone Single-File Defaults -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- UseAppHost is disabled for local dev/run so Windows Smart App Control permits signed dotnet host execution, but enabled for publish -->
    <UseAppHost Condition="'$(RuntimeIdentifier)' == '' and '$(PublishSingleFile)' != 'true'">false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AblationStudio.Core\AblationStudio.Core.csproj" />
    <ProjectReference Include="..\AblationStudio.Rendering\AblationStudio.Rendering.csproj" />
  </ItemGroup>

</Project>
